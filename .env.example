# Required server-side configuration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WISAL_AUTH_PROVIDER=neon
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Platform owner email — the account that receives admin on first login.
# Used by lib/platform-owner.ts. Never commit a real value here.
PLATFORM_OWNER_EMAIL=

# Public canonical URL used by metadata, robots, and sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Error monitoring (Sentry). The DSN is public by design; configure its real
# value only in Vercel. Do not commit a production value here.
NEXT_PUBLIC_SENTRY_DSN=

# Preview-only secret used by the guarded Sentry smoke-test endpoint. Configure
# it only in Vercel Preview; never set it in Production or commit a value here.
SENTRY_SMOKE_TEST_TOKEN=

# Optional: enables source-map upload during production builds. Keep this
# server-only and configure it in Vercel after creating the Sentry project.
SENTRY_AUTH_TOKEN=

# Database-mutating payment tests are opt-in. Never use a production URL here.
# Copy these values into .env.test; PAYMENT_TEST_DATABASE_URL must differ from DATABASE_URL.
PAYMENT_TEST_MODE=
PAYMENT_TEST_DATABASE_URL=
