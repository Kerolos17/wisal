{
  "name": "wisal-wedding",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file=.env --test tests/*.test.mjs",
    "test:payments": "tsx --env-file=.env.test --test tests/payments.test.ts tests/guest-limit.test.ts tests/payment-receipt-submission.test.ts tests/payment-storage-key.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "env:check": "node scripts/check-environment.mjs --target=production",
    "db:generate": "drizzle-kit generate",
    "db:audit": "node --env-file=.env scripts/audit-database-schema.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "db:migrate": "node scripts/migration-safety-gate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
